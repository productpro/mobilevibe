# Preferred setup: create a Paystack Payment Page / checkout URL and add it here.
# This is the only value the current static frontend needs for its purchase buttons.
VITE_PAYSTACK_PAYMENT_URL=

# Optional browser-safe key only if the site later switches to inline Paystack checkout:
# VITE_PAYSTACK_PUBLIC_KEY=

# Secure server-side verification requirements. Never expose these in VITE_* variables
# or paste them into frontend source code:
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
